# Required: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Everything below is optional. Defaults are shown.

# Chat model. Pin exact ids so eval results stay comparable.
# LLM_PROVIDER=google
# LLM_MODEL=gemini-3.6-flash
# Seconds to wait for the model before showing a "took too long" error
# LLM_TIMEOUT_S=60
# EMBED_TIMEOUT_S=30

# To answer with Claude instead: pip install -e ".[anthropic]", then
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Embeddings
# EMBED_PROVIDER=google
# EMBED_MODEL=gemini-embedding-2
# EMBED_DIM=768

# Database. Leave empty to use the bundled local Postgres in ./.pgdata
# DATABASE_URL=postgresql://localhost:5432/ytchat

# Chunking and retrieval
# CHUNK_WORDS=150
# CHUNK_OVERLAP_WORDS=30
# TOP_K=6
# HISTORY_TURNS=6

# Transcripts
# TRANSCRIPT_LANGUAGES=en,hi,te
# YT_PROXY_URL=

# Public deployment guards (0 disables a limit)
# ALLOW_NEW_VIDEOS=true
# MAX_VIDEO_MINUTES=120
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=100
# GLOBAL_DAILY_LIMIT=1000
# TRUST_PROXY_HEADERS=false
